# SecureVote Environment Configuration (Example)
# Copy this file to .env and replace secrets before running in any shared environment.

# Application
APP_NAME=SecureVote
ENVIRONMENT=development
DEBUG=false

# Security (Generate a strong random 32+ byte secret for any non-local usage)
SECRET_KEY=replace-with-a-cryptographically-random-32-byte-secret-key
SESSION_COOKIE_NAME=securevote_session
CSRF_COOKIE_NAME=securevote_csrf
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Database (PostgreSQL recommended; SQLite used as local development fallback)
# PostgreSQL example: postgresql+psycopg://securevote:password@localhost:5432/securevote
DATABASE_URL=sqlite:///./securevote.db

# CORS & Frontend
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate Limiting (Auth endpoints)
AUTH_RATE_LIMIT_MAX_REQUESTS=15
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
